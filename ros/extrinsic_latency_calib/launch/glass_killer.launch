<launch>

  <arg name="maxRange" default="10.0" /> <!--provider cloud crop (m); launcher sets =RANGE_M for long-range runs/-->
  <!--Camera capture latency (s). The stacked cloud is de-rotated with the pose at
      imageTime + imageLatencyOffset; the camera header stamp lags true exposure, so 0.0 projects
      with a stale pose and the seeds yaw while turning. Sweep with IMAGE_LATENCY=0.02 etc./-->
  <arg name="imageLatencyOffset" default="0.0" />
  <node pkg="extrinsic_latency_calib" exec="glassKillerNode" name="Glass_killer_node" output="screen">
    <param name="minRange" value="0.5" />
    <param name="maxRange" value="$(var maxRange)" />
    <param name="angAdjustment" value="0.01" />
    <param name="voxelSize" value="0.05" /> <!--0.02 blew up CPU stages ~6x on outdoor stacks (bldgD_int 2.2s/frame)/-->
    <param name="stackTimeWindow" value="5.0" /> <!--seconds of registered scans to keep in the sliding stack/-->
    <param name="imageLatencyOffset" value="$(var imageLatencyOffset)" />
    <param name="imageSkipYaw" value="10.0" />
    <param name="imageSkipNum" value="2" />
    <param name="camRoll" value="-1.5707963" />
    <param name="camPitch" value="0.0" />
    <param name="camYaw" value="-1.5707963" />
    <param name="camX" value="-0.12" />
    <param name="camY" value="-0.075" />
    <param name="camZ" value="0.255" />
    <param name="is360Cam" value="true" /> <!--360 camera: true, regular camera: false/-->
    <param name="imageWidth" value="1920" /> <!--For both 360 camera and regular camera/-->
    <param name="imageHeight" value="640" /> <!--For both 360 camera and regular camera/-->
    <param name="fx" value="480.0" /> <!--For regular camera only/-->
    <param name="fy" value="480.0" /> <!--For regular camera only/-->
    <param name="cx" value="960.5" /> <!--For regular camera only/-->
    <param name="cy" value="320.5" /> <!--For regular camera only/-->
    <param name="k1" value="0.0" /> <!--For regular camera only/-->
    <param name="k2" value="0.0" /> <!--For regular camera only/-->
    <param name="p1" value="0.0" /> <!--For regular camera only/-->
    <param name="p2" value="0.0" /> <!--For regular camera only/-->
    <param name="habitatWidth" value="640" />
    <param name="habitatHeight" value="480" />
    <param name="habitatFx" value="388.1910413097385" />
    <param name="habitatFy" value="422.0475153598262" />
    <param name="habitatCx" value="320.0" />
    <param name="habitatCy" value="240.0" />
    <param name="habitatScaleXPercent" value="100" /> <!-- raise to narrow horizontally/-->
    <param name="habitatScaleYPercent" value="100" /> <!-- raise to shrink vertically/-->
    <param name="outputFolder" value="./glass_killer_output" />
    <param name="saveOutputs" value="false" /> <!--live glass-killing: publish topics only, no disk writes/-->
    <param name="saveInterval" value="5" />
    <param name="depthPngScale" value="1000.0" />
  </node>

</launch>
